#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"

# Try to find the gem by running it via exe/directly.
begin
  exe_path = Pathname.new(__FILE__).realpath
  gem_root = exe_path.parent.parent
  lib_dir = gem_root.join("lib")

  if lib_dir.directory? && !$LOAD_PATH.include?(lib_dir.to_s)
    $LOAD_PATH.unshift(lib_dir.to_s)
  end
rescue StandardError
  # Simple fallback if realpath fails.
  $LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
end

begin
  require "rawfeed"
  require "rawfeed/command/cli"
rescue LoadError => e
  warn "Error: Could not load 'rawfeed' gem logic. (#{e.message})"
  warn "If you are developing locally, run with: bundle exec exe/rawfeed"
  exit 1
end

Rawfeed::CLI.run(ARGV)
