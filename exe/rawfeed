#!/bin/bash
# --- Self-configuring wrapper for Rawfeed ---
# This script detects its own installation directory and sets GEM_PATH if it is not already set.

# 1. Detect the real location of this script
if [ -n "$BASH_SOURCE" ]; then
    REAL_PATH="$BASH_SOURCE"
else
    REAL_PATH="$0"
fi

# Detect absolute path
REAL_ABS_PATH=$(readlink -f "$REAL_PATH" 2>/dev/null || readlink "$REAL_PATH" 2>/dev/null || echo "$REAL_PATH")
BIN_DIR=$(dirname "$REAL_ABS_PATH")
GEM_ROOT=$(dirname "$BIN_DIR")

# 2. Check if we are running in a custom gem installation
if [ -d "$GEM_ROOT/gems" ] && [ -d "$GEM_ROOT/specifications" ]; then
    # We are in a custom install directory like .bundle-cache/bundle
    if [[ ":$GEM_PATH:" != *":$GEM_ROOT:"* ]]; then
        export GEM_PATH="$GEM_ROOT:$GEM_PATH"
        export GEM_HOME="$GEM_ROOT"
    fi
fi

# 3. Add local lib/ to $LOAD_PATH if we are in the source tree (development)
if [ -d "$GEM_ROOT/lib" ]; then
    RUBY_LIB="-I$GEM_ROOT/lib"
fi

# 4. Execute the Ruby logic
exec ruby $RUBY_LIB -rrawfeed -rrawfeed/cli -e "Rawfeed::CLI.run(ARGV)" -- "$@"
