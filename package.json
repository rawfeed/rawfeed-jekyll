{
  "name": "rawfeed",
  "version": "0.4.0",
  "description": "A raw Jekyll theme for minimalists",
  "type": "module",
  "scripts": {
    "install": "echo 'wait...' && bundle install",
    "minify": "bundle exec rawfeed minify",
    "jekyll:build": "cross-env JEKYLL_ENV=production bundle exec jekyll build",
    "jekyll:serve": "cross-env JEKYLL_ENV=development bundle exec jekyll serve --host 0.0.0.0 --port 4000 --drafts",
    "create:draft": "bundle exec rawfeed create:draft",
    "create:page": "bundle exec rawfeed create:page",
    "create:pixel": "bundle exec rawfeed create:pixel",
    "create:resume": "bundle exec rawfeed create:resume",
    "post:draft": "bundle exec rawfeed post:draft",
    "list:posts": "bundle exec rawfeed list:posts",
    "home:about": "bundle exec rawfeed home:about",
    "home:blog": "bundle exec rawfeed home:blog",
    "blog:disable": "bundle exec rawfeed blog:disable",
    "blog:enable": "bundle exec rawfeed blog:enable",
    "pixels:disable": "bundle exec rawfeed pixels:disable",
    "pixels:enable": "bundle exec rawfeed pixels:enable",
    "clean:cache": "bundle exec rawfeed clean --cache",
    "clean:all": "bundle exec rawfeed clean --all",
    "generate:gem": "bundle exec rake build",
    "build": "npm-run-all clean:cache jekyll:build minify:files",
    "serve": "npm run clean:cache && npm run jekyll:serve",
    "help": "bundle exec rawfeed help"
  },
  "repository": "git+https://github.com/rawfeed/rawfeed-jekyll.git",
  "keywords": [
    "rawfeed",
    "theme",
    "template",
    "jekyll",
    "retro"
  ],
  "author": "William Canin <https://williamcanin.github.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rawfeed/rawfeed-jekyll/issues"
  },
  "homepage": "https://rawfeed.github.io/rawfeed-jekyll",
  "devDependencies": {
    "cross-env": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "del": "^8.0.1",
    "esbuild": "^0.25.11",
    "execa": "^9.6.0",
    "glob": "^11.0.3",
    "html-minifier-terser": "^7.2.0",
    "kleur": "^4.1.5"
  }
}
