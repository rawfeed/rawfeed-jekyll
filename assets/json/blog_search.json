---
layout: none
---

{%- include assigned -%}

[
  {%- for post in site.posts -%}
    {
      "title"    : "{{ post.title | escape }}",
      "date"     : "{{ post.date | date: '%b %-d, %Y' }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ post.url | relative_url }}"
    } {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
