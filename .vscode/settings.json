{
  // ================= EDITOR =================
  "editor.fontFamily": "JetBrains Mono, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.8,
  "editor.fontLigatures": true,
  "editor.rulers": [100],
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.linkedEditing": true,
  "editor.guides.indentation": true,
  "editor.renderLineHighlight": "gutter",
  "editor.minimap.enabled": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.bracketPairColorization.enabled": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",

  // ================= TERMINAL =================
  "terminal.integrated.fontFamily": "DejaVuSansMono Nerd Font",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.tabs.enabled": true,

  // ================= WORKBENCH =================
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-auto",
  "workbench.startupEditor": "newUntitledFile",
  "explorer.compactFolders": false,
  "breadcrumbs.enabled": false,

  // ================= FILE ASSOCIATIONS (O SEGREDO) =================
  "files.associations": {
    "**/assets/js/**/*.js": "liquid-javascript",
    "**/_includes/assigned": "liquid",
    "**/_includes/**/*.html": "liquid",
    "**/_layouts/**/*.html": "liquid",
    "**/*.liquid": "liquid",
    "*.html": "html",
    "*.scss": "scss",
    "*.md": "markdown",
    "LICENSE": "plaintext",
    "CNAME": "plaintext"
  },

  // ================= EMMET DENTRO DO LIQUID =================
  "emmet.includeLanguages": {
    "liquid": "html",
    "markdown": "html"
  },

  // ================= FORMATTERS =================
  "[liquid]": {
    "editor.defaultFormatter": "sissel.shopify-liquid",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  // ================= HTML / LIQUID =================
  "html.format.indentInnerHtml": true,
  "liquid.completion.tags": true,
  "liquid.completion.objects": true,
  "liquid.completion.filters": true,
  "liquid.completion.operators": true,
  "liquid.completion.schema": true,

  // ================= YAML (FRONT MATTER) =================
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": "/.github/workflows/*"
  },

  // ================= RUBY LSP =================
  "rubyLsp.enabledFeatures": [
    "diagnostics",
    "formatting",
    "completion",
    "hover",
    "documentSymbols",
    "definition"
  ],

  // ================= PRETTIER =================
  "prettier.printWidth": 100,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "none",

  // ================= TODO TREE =================
  "todo-tree.general.tags": ["TODO", "FIXME"],

  // ================= SPELL CHECK EXTRA PALAVRAS =================
  "cSpell.words": [
    "rawfeed",
    "williamcanin",
    "canin",
    "markdownify",
    "enddetails",
    "figcaption",
    "endfor",
    "endif",
    "datelang",
    "autoplay",
    "referrerpolicy",
    "noscript",
    "allowfullscreen",
    "endtabs",
    "nbsp",
    "disqus",
    "noopener",
    "noreferrer",
    "giscus",
    "linenos",
    "xmlschema",
    "magick",
    "envrc",
    "direnv",
    "endcomment",
    "inframe",
    "endraw",
    "embedder",
    "hsts",
    "stylesheet",
    "gtag",
    "FOUC",
    "luffy",
    "eiichiro",
    "transitionend",
    "monkī",
    "println",
    "rufi",
    "tabindex",
    "larr",
    "rarr",
    "endcapture",
    "labelledby",
    "recaptcha",
    "describedby",
    "sitekey",
    "grecaptcha",
    "qrcode",
    "itemprop",
    "itemscope",
    "itemtype"
  ],
  "[liquid-javascript]": {
    "editor.defaultFormatter": "sissel.shopify-liquid",
    "editor.formatOnSave": false
  }
}
