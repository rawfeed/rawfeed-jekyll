{
  // ================= EDITOR =================
  "editor.fontFamily": "JetBrains Mono, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.8,
  "editor.fontLigatures": true,
  "editor.rulers": [100],
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.linkedEditing": true,
  "editor.guides.indentation": true,
  "editor.renderLineHighlight": "gutter",
  "editor.minimap.enabled": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.bracketPairColorization.enabled": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",

  // ================= TERMINAL =================
  "terminal.integrated.fontFamily": "DejaVuSansMono Nerd Font",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.env.linux": {
    "PATH": "${env:GEM_BIN}:${env:PATH}"
  },

  // ================= WORKBENCH =================
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-auto",
  "workbench.startupEditor": "newUntitledFile",
  "explorer.compactFolders": false,
  "breadcrumbs.enabled": false,

  // ================= FILE ASSOCIATIONS (O SEGREDO) =================
  "files.associations": {
    "**/assets/js/**/*.js": "liquid-javascript",
    "**/assets/json/blog_search.json": "liquid",
    "**/_data/**/*.yml": "yaml",
    "**/_includes/**/*.html": "liquid",
    "**/_includes/assigned": "liquid",
    "**/_layouts/**/*.html": "liquid",
    "**/*.liquid": "liquid",
    "*.html": "html",
    "*.scss": "scss",
    "*.yml": "yaml",
    "*.yaml": "yaml",
    "*.md": "markdown",
    "LICENSE": "plaintext",
    "CNAME": "plaintext"
  },

  // ================= EMMET DENTRO DO LIQUID =================
  "emmet.includeLanguages": {
    "liquid": "html",
    "markdown": "html"
  },

  // ================= FORMATTERS =================
  "[liquid]": {
    "editor.defaultFormatter": "sissel.shopify-liquid",
    "editor.formatOnSave": false
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  // ================= HTML / LIQUID =================
  "html.format.indentInnerHtml": true,
  "liquid.completion.tags": true,
  "liquid.completion.objects": true,
  "liquid.completion.filters": true,
  "liquid.completion.operators": true,
  "liquid.completion.schema": true,

  // ================= YAML (FRONT MATTER) =================
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": "/.github/workflows/*"
  },

  // ================= RUBY LSP =================
  // "rubyLsp.enabledFeatures": [
  //   "diagnostics",
  //   "formatting",
  //   "completion",
  //   "hover",
  //   "documentSymbols",
  //   "definition"
  // ],

  // ================= PRETTIER =================
  "prettier.printWidth": 100,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "none",

  // ================= TODO TREE =================
  "todo-tree.general.tags": ["TODO", "FIXME"],

  // ================= SPELL CHECK EXTRA PALAVRAS =================
  "cSpell.words": [

  ],
  "[liquid-javascript]": {
    "editor.defaultFormatter": "sissel.shopify-liquid",
    "editor.formatOnSave": false
  },
  "cSpell.customDictionaries": {
    "custom-dictionary-workspace": {
      "name": "custom-dictionary-workspace",
      "path": "${workspaceFolder}/.cspell/custom-dictionary-workspace.txt",
      "addWords": true,
      "scope": "workspace"
    }
  },
  "chat.tools.terminal.autoApprove": {
    "git add": true,
    "git restore": true,
    "git commit": true
  }
}
